{
  "name": "asta-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export": "expo export -p android",
    "prebuild": "expo prebuild --platform android --no-install",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk-local": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
