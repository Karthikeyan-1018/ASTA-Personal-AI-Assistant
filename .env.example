APP_NAME=ASTA
DEBUG=True

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=4096

# Provider timeout configuration (seconds)
GROQ_TIMEOUT_SECONDS=30
OLLAMA_TIMEOUT_SECONDS=120

# PostgreSQL database configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=asta_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
# Opt-in SQL echo. Keep false in normal use because it logs bound parameters.
DB_ECHO=false

# Semantic memory configuration
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
SEMANTIC_SIMILARITY_THRESHOLD=0.75
SEMANTIC_RETRIEVAL_ENABLED=true

# Conversation persistence configuration
CONVERSATION_HISTORY_LIMIT=20
CONVERSATION_MESSAGE_PAGE_SIZE=50

# User preference configuration
PREFERENCE_RETRIEVAL_LIMIT=8
PREFERENCE_RELEVANCE_THRESHOLD=0.15
PREFERENCE_MAX_VALUE_CHARS=1000

# Unified context configuration
CONTEXT_MAX_CHARS=12000
CONTEXT_PREFERENCE_SECTION_CHARS=2500
CONTEXT_MEMORY_SECTION_CHARS=5000
CONTEXT_HISTORY_SECTION_CHARS=6000
CONTEXT_TASK_SECTION_CHARS=2000
CONTEXT_DEADLINE_SECTION_CHARS=2000
# Highest priority first. The current user message is always highest.
CONTEXT_PRIORITY_ORDER=history,task,deadline,preference,memory

# Task and deadline configuration
TASK_DEFAULT_UPCOMING_DAYS=7
TASK_CONTEXT_UPCOMING_DAYS=7
TASK_CONTEXT_LIMIT=5
DEADLINE_CONTEXT_LIMIT=5

# Natural-language task management
TASK_INTENT_ENABLED=true
TASK_INTENT_LLM_ENABLED=true
TASK_ACTION_CONFIRMATION_TTL_SECONDS=600
# Leave empty to always ask for a timezone on timed deadlines.
TASK_DEFAULT_TIMEZONE=
TASK_INTENT_MAX_RESULTS=20
# ---------------------------------------------------------------------------
# Task reminders, background scheduler, notifications, and recurrence (Phase 10)
# ---------------------------------------------------------------------------
# Local wall-clock anchor for date-only reminder offsets.
REMINDER_DEFAULT_LOCAL_TIME=09:00

# Background scheduler. Work is claimed from PostgreSQL, so a restart resumes
# pending reminders and recurrence rules without an external queue. Set the
# enabled flag to false to run the API without an in-process worker.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_POLL_SECONDS=30
REMINDER_SCHEDULER_BATCH_SIZE=25
# A claimed reminder older than this lease is treated as abandoned and
# returned to the pending queue for another worker.
REMINDER_PROCESSING_LEASE_SECONDS=300
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_BACKOFF_SECONDS=60
REMINDER_RETRY_BACKOFF_MULTIPLIER=2
REMINDER_RETRY_BACKOFF_MAX_SECONDS=3600
REMINDER_SCHEDULER_SHUTDOWN_TIMEOUT_SECONDS=10

# Notification history retention. Only read notifications older than this are
# purged. A value of 0 (or less) disables purging entirely.
NOTIFICATION_RETENTION_DAYS=365
# Reserved for future delivery channels. In-app delivery is complete when the
# notification row is persisted, so marker recovery is always attempted.
NOTIFICATION_MAX_ATTEMPTS=5
# Snoozing re-arms the reminder behind a delivered notification instead of
# creating a second notification. The limit is per notification; 0 or less means
# unlimited. The maximum single snooze window is in minutes (default 365 days).
NOTIFICATION_SNOOZE_MAX_COUNT=10
NOTIFICATION_MAX_SNOOZE_MINUTES=525600

# Quiet-hours defaults apply until the owner saves explicit preferences through
# PATCH /api/notifications/preferences. Windows may cross midnight and are
# evaluated in the owner's IANA timezone. Reminders are deferred, never dropped.
NOTIFICATION_QUIET_HOURS_DEFAULT_ENABLED=false
NOTIFICATION_QUIET_HOURS_DEFAULT_START=22:00
NOTIFICATION_QUIET_HOURS_DEFAULT_END=07:00
NOTIFICATION_QUIET_HOURS_DEFAULT_TIMEZONE=UTC

# Recurring task generation. Generation is finite: bounded by end_date, the
# per-run cap, and the configured horizon. Occurrence dates are unique.
RECURRENCE_GENERATION_ENABLED=true
RECURRENCE_GENERATION_HORIZON_DAYS=30
RECURRENCE_GENERATION_BATCH_SIZE=25
RECURRENCE_MAX_GENERATIONS_PER_RUN=10
RECURRENCE_GENERATION_INTERVAL_SECONDS=3600
RECURRENCE_RETRY_BACKOFF_SECONDS=300
RECURRENCE_PROCESSING_LEASE_SECONDS=300

# ---------------------------------------------------------------------------
# Single-owner authentication (Phase 8)
# ---------------------------------------------------------------------------
# Bootstrap token for POST /api/auth/setup. Leave EMPTY after creating the
# owner. Generate a long random value, for example with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value or reuse this token elsewhere.
AUTH_OWNER_SETUP_TOKEN=

# Session lifetime in hours (default 7 days). Minimum 1 hour.
AUTH_SESSION_LIFETIME_HOURS=168

# Cookie names and scope.
AUTH_SESSION_COOKIE_NAME=asta_session
AUTH_CSRF_COOKIE_NAME=asta_csrf
AUTH_COOKIE_PATH=/api
AUTH_CSRF_COOKIE_PATH=/

# Keep this true for LAN access. Only set false for loopback HTTP development.
# Plain HTTP on Wi-Fi must never carry credentials.
AUTH_COOKIE_SECURE=true

# lax | strict | none. "none" also requires Secure=true.
AUTH_COOKIE_SAMESITE=lax

# Throttle for session last-used writes (seconds).
AUTH_SESSION_LAST_USED_UPDATE_SECONDS=300

# Password policy.
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128

# Argon2id cost parameters (RFC 9106 low-memory profile).
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST=65536
AUTH_ARGON2_PARALLELISM=4

# ---------------------------------------------------------------------------
# Login rate limiting (Phase 8.1)
# ---------------------------------------------------------------------------
# Failed login and setup attempts are counted per source IP plus normalised
# account identifier. State is stored in PostgreSQL and survives restarts.
AUTH_LOGIN_RATE_LIMIT_ENABLED=true

# Five failures start a 15-minute cooldown. The next cooldown doubles, up to
# the cap. Cooldowns always expire; the owner is never permanently locked.
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_INITIAL_COOLDOWN_MINUTES=15
AUTH_LOGIN_COOLDOWN_MULTIPLIER=2
AUTH_LOGIN_MAX_COOLDOWN_MINUTES=1440

# Purge attempt rows whose last failure is older than this. Keep it larger than
# the maximum cooldown.
AUTH_LOGIN_ATTEMPT_RETENTION_HOURS=48

# Comma-separated reverse-proxy addresses whose X-Forwarded-For header may be
# trusted. Leave EMPTY unless ASTA is behind a proxy you control. Never add a
# client address or a public proxy.
AUTH_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# AI optimization and context (Phase 9)
# ---------------------------------------------------------------------------
# Token-aware context budgeting. Counting uses a deterministic, conservative
# heuristic; no tokenizer model is downloaded at request time.
AI_TOKEN_BUDGET_ENABLED=true
AI_CHARS_PER_TOKEN=4.0
# Provider context windows are resolved in this order:
#   AI_MODEL_CONTEXT_WINDOWS override -> provider default below.
AI_DEFAULT_CONTEXT_WINDOW_TOKENS=8192
AI_GROQ_CONTEXT_WINDOW_TOKENS=131072
AI_OLLAMA_CONTEXT_WINDOW_TOKENS=40960
# Optional comma-separated "model:tokens" overrides. Model names are matched
# case-sensitively. Example:
#   AI_MODEL_CONTEXT_WINDOWS=openai/gpt-oss-20b:131072,qwen3:8b:40960
AI_MODEL_CONTEXT_WINDOWS=
# Tokens reserved for the answer and a safety margin.
AI_RESPONSE_RESERVE_TOKENS=1024
AI_CONTEXT_SAFETY_TOKENS=256

# Deterministic query classification. The optional LLM fallback is disabled by
# default; it never runs for private requests and can never trigger a task
# mutation. A deterministic result at or above the threshold is kept as-is.
AI_QUERY_CLASSIFIER_ENABLED=true
AI_QUERY_CLASSIFIER_LLM_FALLBACK_ENABLED=false
AI_QUERY_CLASSIFIER_LLM_FALLBACK_THRESHOLD=0.6

# Routing policy: groq_first | local_first | cost_aware.
# Private requests always use Ollama only, regardless of this setting.
AI_ROUTING_POLICY=groq_first
# cost_aware per-complexity provider mapping. Values must be "groq" or
# "ollama". Unknown values fall back to Groq for non-private requests.
AI_ROUTING_SIMPLE_PROVIDER=ollama
AI_ROUTING_MODERATE_PROVIDER=groq
AI_ROUTING_COMPLEX_PROVIDER=groq
AI_ROUTING_DYNAMIC_PROVIDER=groq
# Optional comma-separated "complexity:provider:model" overrides. Supported
# complexities: simple, moderate, complex, dynamic_information, task_action.
# Use "default" or "*" for an all-complexity override.
# Example:
#   AI_ROUTING_MODEL_OVERRIDES=simple:ollama:qwen3:8b,default:groq:openai/gpt-oss-20b
AI_ROUTING_MODEL_OVERRIDES=

# Optional provider prices (USD per one million tokens). Zero means "unknown";
# usage summaries report a cost only when a positive price is configured.
AI_GROQ_INPUT_COST_PER_MILLION=0
AI_GROQ_OUTPUT_COST_PER_MILLION=0
AI_OLLAMA_INPUT_COST_PER_MILLION=0
AI_OLLAMA_OUTPUT_COST_PER_MILLION=0

# Semantic response cache. Only stateless, non-private, non-sensitive,
# non-dynamic eligible requests are cached. Cache rows are user-scoped and
# store a query hash plus an optional pgvector embedding, never raw prompts.
AI_CACHE_ENABLED=true
# Cosine-similarity threshold for semantic matches (PostgreSQL/pgvector only).
AI_CACHE_SIMILARITY_THRESHOLD=0.95
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_ENTRIES_PER_USER=500
# Bump either version to invalidate existing cache entries after a prompt or
# configuration change.
AI_CACHE_PROMPT_VERSION=phase9-v1
AI_CACHE_CONFIG_VERSION=1
AI_CACHE_ALLOWED_COMPLEXITIES=simple,moderate
AI_CACHE_STATELESS_ONLY=true
# Disable to use exact query-hash matching only.
AI_CACHE_SEMANTIC_ENABLED=true

# Structured usage and performance tracking. Records contain metadata and
# token counts only; prompt text, response text, credentials, and provider
# error messages are never stored.
AI_USAGE_TRACKING_ENABLED=true
AI_USAGE_RETENTION_DAYS=90
AI_USAGE_RECENT_LIMIT=50

# Hybrid memory retrieval blends semantic and keyword signals. Keyword
# retrieval remains the fallback when semantic retrieval is unavailable.
AI_MEMORY_HYBRID_ENABLED=true
AI_MEMORY_SEMANTIC_WEIGHT=0.7
AI_MEMORY_KEYWORD_WEIGHT=0.3
AI_MEMORY_CANDIDATE_LIMIT=20
AI_MEMORY_MIN_HYBRID_SCORE=0.05

# ---------------------------------------------------------------------------
# Tool engine and chat integration (Phases 11A-11I)
# ---------------------------------------------------------------------------
# Tool calling is opt-in. With this false, chat is unchanged and no tool
# definitions are sent to a provider.
TOOL_CALLING_ENABLED=false

# Bounded tool loop. TOOL_MAX_ROUNDS limits provider turns that may request
# tools; one final text-only turn is always allowed afterwards.
TOOL_MAX_ROUNDS=2
TOOL_MAX_CALLS_PER_REQUEST=5
TOOL_MAX_CALLS_PER_TURN=8
TOOL_MAX_RESULT_CONTEXT_BYTES=50000
TOOL_LOOP_PREVENTION_ENABLED=true

# Per-call execution and result bounds.
TOOL_EXECUTION_TIMEOUT_SECONDS=15
TOOL_MAX_ARGUMENT_BYTES=16384
TOOL_MAX_RESULT_BYTES=20000

# Confirmations are owner-, conversation-, and argument-bound, single-use, and
# expire automatically. Sensitive tools also require TOOL_ALLOW_SENSITIVE.
TOOL_CONFIRMATION_TTL_SECONDS=600
TOOL_CONFIRMATION_MAX_PENDING=10
TOOL_ALLOW_SENSITIVE=false

# Metadata-only execution history retention.
TOOL_HISTORY_ENABLED=true
TOOL_EXECUTION_RETENTION_DAYS=90

# Bounded retries are opt-in and only apply to read-only tools that declare
# themselves idempotent and do not require confirmation. State-changing tools
# are never retried automatically. Retries are capped at 3 per attempt.
TOOL_RETRY_ENABLED=false
TOOL_MAX_RETRIES=1
TOOL_RETRY_BACKOFF_MS=250

# On startup, stale in-flight executions from a previous process are marked
# cancelled. The stale cutoff must exceed the longest expected execution in a
# multi-process deployment.
TOOL_RECOVERY_ON_STARTUP=true
TOOL_STALE_EXECUTION_SECONDS=300

# ---------------------------------------------------------------------------
# Web search tool (Phase 11E)
# ---------------------------------------------------------------------------
# Disabled by default. The model can only discover this tool when the general
# tool-calling path is also enabled (see TOOL_CALLING_ENABLED in README.md).
# Providers:
#   searxng - self-hosted metasearch with format=json enabled; no API key.
#   tavily  - managed API at https://api.tavily.com/search; API key required.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=searxng
# SearXNG base URL, for example https://search.example.org
WEB_SEARCH_BASE_URL=
# Tavily API key. Never commit a real value.
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_RESPONSE_BYTES=262144

# ---------------------------------------------------------------------------
# Filesystem tools (Phase 11F)
# ---------------------------------------------------------------------------
# Disabled by default. These tools only operate inside the explicitly approved
# roots below. They cannot delete files, execute files, or run shell commands.
# The general tool-calling path must also be enabled (TOOL_CALLING_ENABLED).
TOOL_FILESYSTEM_ENABLED=false

# Comma-separated absolute directories. Drive roots, Windows system
# directories, sensitive directories, and roots that contain or live inside
# those locations are ignored. Leave EMPTY to keep the tools disabled.
# Example: C:\Users\karth\Documents\asta-workspace
TOOL_WORKSPACE_ROOTS=

TOOL_FILE_MAX_READ_BYTES=200000
TOOL_FILE_MAX_WRITE_BYTES=100000
TOOL_FILE_MAX_LIST_ENTRIES=500
TOOL_FILE_MAX_SEARCH_RESULTS=100

# ---------------------------------------------------------------------------
# Python execution sandbox (Phase 11G)
# ---------------------------------------------------------------------------
# Disabled by default. Requires Windows 8 or later, the Windows AppContainer
# API, and a standalone Python 3 interpreter. Execution also requires
# TOOL_ALLOW_SENSITIVE=true and per-call user confirmation.
#
# The child process runs under a disposable AppContainer token with no
# capabilities, inside a Job Object. It cannot read ASTA files or user files,
# create child processes, or use the network. Only a fresh temporary workspace
# is writable. On unsupported platforms the tool fails closed.
PYTHON_SANDBOX_ENABLED=false

# Wall-clock limit. Clamped below TOOL_EXECUTION_TIMEOUT_SECONDS so the
# sandbox can terminate its process tree before the executor cancels.
PYTHON_SANDBOX_TIMEOUT_SECONDS=5

# CPU time limit for the sandbox process.
PYTHON_SANDBOX_CPU_SECONDS=5

# Job/process memory limit in megabytes. Values below 32 are rejected.
PYTHON_SANDBOX_MEMORY_MB=256

# Maximum submitted source size and combined captured output size.
PYTHON_SANDBOX_MAX_SOURCE_BYTES=20000
PYTHON_SANDBOX_MAX_OUTPUT_BYTES=20000

# Network access is not supported by the AppContainer backend. Keep this
# false; a true value makes the tool fail closed with a configuration error.
PYTHON_SANDBOX_ALLOW_NETWORK=false

# Optional absolute directory for per-execution workspaces. Leave EMPTY to use
# the system temporary directory. Workspaces are always deleted afterwards.
PYTHON_SANDBOX_WORKSPACE_PARENT=

# ---------------------------------------------------------------------------
# Local-network access
# ---------------------------------------------------------------------------
# Comma-separated explicit frontend origins. Leave EMPTY for a same-origin
# deployment. Never use "*" together with credentials.
# Example: https://192.168.1.20:8443,https://asta.local:8443
CORS_ALLOWED_ORIGINS=

# Comma-separated Host header allowlist. Add the laptop's LAN IP or mDNS name
# before opening ASTA from the phone, e.g. 192.168.1.20,asta.local.
TRUSTED_HOSTS=localhost,127.0.0.1,::1,testserver,test
